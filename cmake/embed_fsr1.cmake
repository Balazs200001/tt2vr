# Embeds the FSR1 shader headers (third_party/fidelityfx-fsr1) as byte arrays, so the runtime shader compiler can
# #include them (they are larger than MSVC's string-literal limit). Runs at configure time; editing a header
# re-runs the configure step.
function(tt2vr_embed_fsr1 out_dir)
    set(src_dir "${CMAKE_SOURCE_DIR}/third_party/fidelityfx-fsr1")
    set(out "${out_dir}/fsr1_headers.inc")
    set(text "// Generated by cmake/embed_fsr1.cmake from third_party/fidelityfx-fsr1 (MIT). Do not edit.\n")
    foreach(name ffx_a ffx_fsr1)
        set(file "${src_dir}/${name}.h")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR size "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND text "inline constexpr unsigned char k_${name}_h[] = {${bytes}};\n")
        string(APPEND text "inline constexpr unsigned long long k_${name}_h_size = ${size};\n")
    endforeach()
    file(WRITE "${out}.tmp" "${text}")
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
endfunction()
